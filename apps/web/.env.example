# Copy to .env.local. Never place server keys in NEXT_PUBLIC_*.
DATABASE_URL="file:./cutling.db"
APP_ORIGIN="http://localhost:3000"
AI_MODE="rules"
ALLOWED_AI_MODES="rules,demo,live"
HCX_API_KEY=
HCX_BASE_URL="https://clovastudio.stream.ntruss.com"
HCX_LIGHT_MODEL=
HCX_REASONING_MODEL=
HCX_EMBEDDING_MODEL=
HCX_CHAT_ENDPOINT=
HCX_EMBEDDING_ENDPOINT=
HCX_REQUEST_TIMEOUT_MS="15000"
HCX_MAX_CONCURRENCY="2"
# Optional operator-entered prices per million tokens, see docs/metrics.md
MODEL_PRICING_JSON=
# Local OCR downloads Korean+English trained data on first use; no image upload to provider.
OCR_ENABLED="true"
# Local benchmark is free/rules-only. Paid comparative benchmark is not enabled.
BENCHMARK_ENABLED="true"
